DEEPSEEK_API_KEY=sk-your-key-here

# OCR — pick ONE:
#  - GEMINI_API_KEY → no Python needed, fast, free tier 15 req/min
#    Get a key at https://aistudio.google.com/apikey (free, sign in with Google)
#  - OCR_BASE_URL → self-hosted Pix2Text Python sidecar (free, no per-call cost)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OCR_PROVIDER=auto
OCR_BASE_URL=http://127.0.0.1:7800
OCR_TOKEN=

# Supabase (filled after creating a project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
